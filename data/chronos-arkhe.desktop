[Desktop Entry]
Type=Application
Name=Chronos Arkhe
GenericName=Organizador de Fotos por Data
Comment=Organiza fotografias em coleções por data de captura (EXIF)
Keywords=fotos;fotografia;organizador;data;exif;coleções;chronos;arkhe;
Exec=chronos-arkhe %F
Icon=chronos-arkhe
Categories=Graphics;Photography;GTK;
Terminal=false
StartupNotify=true
StartupWMClass=chronos-arkhe
MimeType=image/jpeg;image/png;image/tiff;image/webp;image/x-canon-cr2;image/x-canon-crw;image/x-canon-cr3;image/x-nikon-nef;image/x-sony-arw;image/x-adobe-dng;inode/directory;

# Nautilus integration
X-Nautilus-Actions=true
